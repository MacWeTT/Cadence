# Supabase (filled in Task 9; local values come from `npx supabase status`)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Only for the e2e tests (the local Supabase demo key from `npx supabase status`). Never put a real service key here.
# SUPABASE_SERVICE_ROLE_KEY=

# Contact form email (optional: without these the message is still saved in the contact_messages table).
# Create an API key at resend.com. CONTACT_FROM_EMAIL must be an address Resend lets you send from
# (for a first test, "Cadence <onboarding@resend.dev>" works when CONTACT_TO_EMAIL is the email you signed up to Resend with).
# RESEND_API_KEY=
# CONTACT_TO_EMAIL=
# CONTACT_FROM_EMAIL=
