{
  "name": "cadence",
  "version": "0.8.5",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint && node scripts/check-tailwind-classes.mjs",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "db:start": "supabase start -x imgproxy,vector,logflare,edge-runtime,supavisor,mailpit",
    "db:test": "supabase test db",
    "db:types": "supabase gen types typescript --local > src/lib/supabase/database.types.ts",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\" \"e2e/**/*.ts\" \"tests/**/*.ts\" \"*.{ts,mts,mjs,json}\" \"eslint-rules/*.mjs\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css}\" \"e2e/**/*.ts\" \"tests/**/*.ts\" \"*.{ts,mts,mjs,json}\" \"eslint-rules/*.mjs\"",
    "verify": "npm run format:check && npm run lint && npm run typecheck && npm test && npm run build",
    "verify:full": "npm run verify && npm run db:test && npx playwright test",
    "build:desktop": "node scripts/build-desktop.mjs",
    "tauri": "tauri"
  },
  "dependencies": {
    "@pdf-lib/fontkit": "^1.1.1",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.117.3",
    "@tanstack/react-query": "^5.104.1",
    "@tauri-apps/api": "2.12.4",
    "@tauri-apps/plugin-autostart": "^2.7.0",
    "@tauri-apps/plugin-deep-link": "^2.6.2",
    "@tauri-apps/plugin-notification": "^2.7.0",
    "@tauri-apps/plugin-opener": "^2.7.2",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "frimousse": "^0.4.0",
    "lucide-react": "^1.54.0",
    "motion": "^14.1.0",
    "next": "16.4.2",
    "next-intl": "^4.14.9",
    "next-themes": "^0.4.6",
    "pdf-lib": "^1.17.1",
    "radix-ui": "^1.7.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "shadcn": "^4.21.4",
    "sonner": "^2.0.8",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@tailwindcss/turbopack": "^4",
    "@tauri-apps/cli": "2.12.4",
    "@types/node": "^24.19.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "prettier": "^3.9.10",
    "supabase": "^2.120.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^5.0.3"
  }
}
