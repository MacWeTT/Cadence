{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Cadence",
  "version": "../package.json",
  "identifier": "app.cadence.desktop",
  "build": {
    "frontendDist": "../out",
    "beforeDevCommand": "npm run build:desktop",
    "beforeBuildCommand": "npm run build:desktop"
  },
  "app": {
    "windows": [
      {
        "title": "Cadence",
        "width": 1180,
        "height": 800,
        "minWidth": 420,
        "minHeight": 560,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true,
    "publisher": "MacWeTT",
    "copyright": "Copyright (c) MacWeTT",
    "shortDescription": "Cadence, the habit tracker"
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": [
          "cadence"
        ]
      }
    },
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDIxMUU1NUJGODlFQzI0NTIKUldSU0pPeUp2MVVlSVV3enlrNUdLeFpSU3E2ZmUwTWFFZlluQXJBS1BQTGRUdktRamdiZkhXZXcK",
      "endpoints": [
        "https://github.com/MacWeTT/Cadence/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
